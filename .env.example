# ---------------------------------------------------------------------------
# LexDesk environment. One deployment per firm; every value is firm-specific.
# Never commit real values. In production these live in the Render env group.
# ---------------------------------------------------------------------------

# Firm identity and tier
FIRM_SLUG=demo-firm
FIRM_TIER=solo                       # solo | firm
FIRM_TIMEZONE=America/Chicago        # IANA zone; deadlines display in this zone
DEMO_MODE=false                      # true = synthetic data only, no outbound messaging

# Public URL of this deployment (used for auth callbacks and invite links)
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lexdesk_dev
DATABASE_URL_READONLY=               # optional; used by read-only reporting in later phases

# Auth (generate with: openssl rand -base64 48)
AUTH_SECRET=

# Field-level encryption key, 32 bytes base64 (openssl rand -base64 32)
FIELD_ENCRYPTION_KEY=

# GoHighLevel (Phase 1). Must be empty when DEMO_MODE=true.
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=                  # >= 32 chars; sent by snapshot workflows in x-lexdesk-webhook-secret
GHL_WEBHOOK_PUBLIC_KEY=              # optional PEM override for GHL's x-wh-signature key (rotation)

# Anthropic (Phase 2). VERIFY model IDs at docs.claude.com before setting.
ANTHROPIC_API_KEY=
MODEL_FAST=
MODEL_STANDARD=
MODEL_DEEP=
ALLOW_RAW_DOCUMENT_TO_LLM=false

# Storage (Phase 3)
S3_BUCKET=
S3_REGION=
KMS_KEY_ID=
AWS_ACCESS_KEY_ID=                   # IAM user scoped to this firm's bucket, key and Textract
AWS_SECRET_ACCESS_KEY=
STORAGE_DIR=                         # local document store for development and demos (default ./.storage)
OCR_ENGINE=                          # textract (with S3) or text_layer (PDF text only); default follows S3_BUCKET

# Observability
SENTRY_DSN=
LOG_LEVEL=info
